@model SGI_JMC.Models.DeclaracaoTransferenciaProSic

@{
    ViewData["Title"] = "Create";
}
<hr />
<div class="container-fluid">
    <div class="card mb-3">
        <div class="card-header">
            <h4><b>Declaração para Transferência (ProSic)</b></h4>
            <h6>Preencha os dados e clique em baixar declaração, o download iniciará automaticamente</h6>
        </div>
        <div class="card-body">
            <form asp-action="gerarDeclaracaoTransferenciaProSic">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Name" class="control-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Father_name" class="control-label"></label>
                            <input asp-for="Father_name" class="form-control" />
                            <span asp-validation-for="Father_name" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Mother_name" class="control-label"></label>
                            <input asp-for="Mother_name" class="form-control" />
                            <span asp-validation-for="Mother_name" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Birth_date" class="control-label"></label>
                            <input asp-for="Birth_date" class="form-control" />
                            <span asp-validation-for="Birth_date" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="anoLetivo" class="control-label"></label>
                            <input asp-for="anoLetivo" class="form-control" MaxLength="4" />
                            <span asp-validation-for="anoLetivo" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="faseProSic" class="control-label"></label>
                            <input asp-for="faseProSic" MaxLength="01" placeholder="3 ou 4" class="form-control" />
                            <span asp-validation-for="faseProSic" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="serieOrigem" class="control-label"></label>
                            <input asp-for="serieOrigem" MaxLength="01" placeholder="" class="form-control" />
                            <span asp-validation-for="serieOrigem" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="numeroDoNis" class="control-label"></label>
                            <input asp-for="numeroDoNis" MaxLength="11" class="form-control" />
                            <span asp-validation-for="numeroDoNis" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="codigoSeed" class="control-label"></label>
                            <input asp-for="codigoSeed" MaxLength="10" class="form-control" />
                            <span asp-validation-for="codigoSeed" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-12" style="text-align:center">
                        @*<input type="submit" value="Baixar declaração" class="btn btn-primary" />*@
                        <button type="submit" class="btn btn-success"><i class="fa fa-download" aria-hidden="true"></i> Baixar declaração</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }
