@model VerificarAutenticidadeViewModel

@{
    ViewData["Title"] = "Verificar autenticidade de documento - ";
}

<partial name="_MensagemPartial" />

<div asp-validation-summary="ModelOnly" class="val-summary text-danger my-3"></div>
<div class="text-center">
    <h1 class="display-4">Sistema de Gerenciamento Interno</h1>
    <p></p>
    <h3 class="display-6">Escola Estadual João de Mattos Carvalho</h3>
    <p></p>
</div>
<div class="container-fluid">
    <div class="card mb-12">
        <div class="card-header">
            <h4><b>Verificação de autenticidade de documento</b></h4>
            <h6>Insira o número e o código de verificação do documento para veficicar sua autenticidade</h6>
        </div>
        <div class="card-body">
            <form asp-action="VerificarAutenticidade">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label asp-for="NumeroDeclaracao" class="control-label"></label>
                            <input asp-for="NumeroDeclaracao" class="form-control" />
                            <span asp-validation-for="NumeroDeclaracao" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="CodigoDeVerificacao" class="control-label"></label>
                            <input asp-for="CodigoDeVerificacao" class="form-control" />
                            <span asp-validation-for="CodigoDeVerificacao" class="text-danger"></span>
                        </div>
                        <div style="align-items:center">
                            <button type="submit" class="btn btn-primary">Verificar Autenticidade</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }