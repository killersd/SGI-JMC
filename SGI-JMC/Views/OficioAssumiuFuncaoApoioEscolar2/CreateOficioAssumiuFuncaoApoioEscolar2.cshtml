@model SGI_JMC.Models.OficioAssumiuFuncaoApoioEscolar2

@{
    ViewData["Title"] = "Ofício assumiu função - Apoio Escolar II";
}
<hr />
<div class="container-fluid">
    <div class="card mb-3">
        <div class="card-header">
            <h4><b>Ofício de Assumiu Função (Apoio Escolar II)</b></h4>
        </div>
        <div class="card-body">
            <form asp-action="gerarOficioApoioEscolar2">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="NumeroOficio" class="control-label"></label>
                            <input asp-for="NumeroOficio" class="form-control" />
                            <span asp-validation-for="NumeroOficio" class="text-danger"></span>
                        </div>
                        <div class="form-group" style="width:504px;height:62px;">
                            <label asp-for="destinatario" class="control-label"></label>
                            <fieldset>
                                <div>
                                    <input asp-for="destinatario" type="radio" id="" name="destinatario" value="Daniela Silva">
                                    <label for="Daniela Silva">Daniela Silva</label>
                                </div>
                                <div>
                                    <input asp-for="destinatario" type="radio" id="" name="destinatario" value="Kleber do Carmo">
                                    <label for="Kleber do Carmo">Kleber do Carmo</label>
                                </div>
                            </fieldset>
                            <span asp-validation-for="destinatario" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="CidadeDestinatario" class="control-label"></label>
                            <input asp-for="CidadeDestinatario" class="form-control" />
                            <span asp-validation-for="CidadeDestinatario" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Name" class="control-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="disciplina" class="control-label"></label>
                            <input asp-for="disciplina" class="form-control" />
                            <span asp-validation-for="disciplina" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="CargaHorariaMensal" class="control-label"></label>
                            <input asp-for="CargaHorariaMensal" class="form-control" />
                            <span asp-validation-for="CargaHorariaMensal" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Assunto" class="control-label"></label>
                            <input asp-for="Assunto" class="form-control" />
                            <span asp-validation-for="Assunto" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="CargoDestinatario" class="control-label"></label>
                            <input asp-for="CargoDestinatario" class="form-control" />
                            <span asp-validation-for="CargoDestinatario" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="vinculo" class="control-label"></label>
                            <input asp-for="vinculo" class="form-control" placeholder="contratado, efetivo, comissionado, cedido..." />
                            <span asp-validation-for="vinculo" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="CPF" class="control-label"></label>
                            <input asp-for="CPF" placeholder="apenas números" maxlength="11" class="form-control" />
                            <span asp-validation-for="CPF" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="DataAssumiuFuncao" class="control-label"></label>
                            <input asp-for="DataAssumiuFuncao" class="form-control"/>
                            <span asp-validation-for="DataAssumiuFuncao" class="text-danger"></span>
                        </div>
                    </div>
                    <p></p>
                    <div class="col-md-12" style="text-align:center">
                        <button type="submit" class="btn btn-success"><i class="fa fa-download" aria-hidden="true"></i> Baixar ofício</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }
