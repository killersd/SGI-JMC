@model SGI_JMC.Models.OficioAssumiuFuncao

@{
    ViewData["Title"] = "Ofício assumiu função";
}
<hr />
<div class="container-fluid">
    <div class="card mb-3">
        <div class="card-header">
            <h4><b>Ofício de Assumiu Função</b></h4>
            <h6>Modelo de ofício para <b>professores(as)</b> que assumiram função</h6>
        </div>
        <div class="card-body">
            <form asp-action="gerarOficio">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="NumeroOficio" class="control-label"></label>
                            <input asp-for="NumeroOficio" class="form-control" />
                            <span asp-validation-for="NumeroOficio" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Assunto" class="control-label"></label>
                            <input asp-for="Assunto" class="form-control" />
                            <span asp-validation-for="Assunto" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="destinatario" class="control-label"></label>
                            <input asp-for="destinatario" placeholder="Para quem é o ofício?" class="form-control" />
                            <span asp-validation-for="destinatario" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Name" class="control-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="CPF" class="control-label"></label>
                            <input asp-for="CPF" placeholder="Somente números" class="form-control" MaxLength="11" />
                            <span asp-validation-for="CPF" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="DataAssumiuFuncao" class="control-label"></label>
                            <input asp-for="DataAssumiuFuncao" class="form-control" />
                            <span asp-validation-for="DataAssumiuFuncao" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="CargaHoraria" class="control-label"></label>
                            <input asp-for="CargaHoraria" placeholder="Carga horária semanal" class="form-control" />
                            <span asp-validation-for="CargaHoraria" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="disciplina" class="control-label"></label>
                            <input asp-for="disciplina" class="form-control" />
                            <span asp-validation-for="disciplina" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="vinculo" class="control-label"></label>
                            <input asp-for="vinculo" placeholder="Contratado ou efetivo" class="form-control" />
                            <span asp-validation-for="vinculo" class="text-danger"></span>
                        </div>
                        @*                 <div class="form-group">
                        <label asp-for="qtdFaltas" class="control-label"></label>
                        <input asp-for="qtdFaltas" class="form-control" MaxLength="4" />
                        <span asp-validation-for="qtdFaltas" class="text-danger"></span>
                        </div>*@
                    </div>
                    <div class="col-md-12" style="text-align:center">
                        @*<input type="submit" value="Baixar declaração" class="btn btn-primary" />*@
                        <button type="submit" class="btn btn-success"><i class="fa fa-download" aria-hidden="true"></i> Baixar ofício</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }
