@model SGI_JMC.Models.ListaFrequencia

@{
    ViewData["Title"] = "Lista de frequência - ";
}

<partial name="_MensagemPartial" />
<partial name="_NotificationPartial" />
@*<div asp-validation-summary="ModelOnly" class="val-summary text-danger my-3"></div>*@
<hr />
<div class="container-fluid">
    <div class="card mb-6">
        <div class="card-header">
            <h4><b>Lista de frequência</b></h4>
        </div>
        <div class="card-body">
            <form asp-action="DownloadListaFrequencia">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label asp-for="Ano" class="control-label"></label>
                            <input asp-for="Ano" class="form-control" value="2023" readonly />
                            <span asp-validation-for="Ano" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Turno" class="control-label"></label>
                            <fieldset>
                                <div>
                                    <input asp-for="Turno" type="radio" id="Matutino" name="Turno" value="Matutino">
                                    <label for="Matutino">Matutino</label>
                                    <input asp-for="Turno" type="radio" id="Vespertino" name="Turno" value="Vespertino">
                                    <label for="Vespertino">Vespertino</label>
                                </div>
                            </fieldset>
                            <span asp-validation-for="Ano" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Turma" class="control-label"></label>
                            <select asp-for="Turma" class="form-control" asp-items="ViewBag.Turmas"></select>
                            <span asp-validation-for="Turma" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Mes" class="control-label"></label>
                            <select asp-for="Mes" class="form-control" asp-items="ViewBag.Meses"></select>
                            <span asp-validation-for="Mes" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-12" style="text-align:center">
                        @*<input type="submit" value="Baixar declaração" class="btn btn-default" />*@
                        <button type="submit" class="btn btn-default" style="color:#fbc45f"><i class="fa fa-download" aria-hidden="true"></i> Baixar lista</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }