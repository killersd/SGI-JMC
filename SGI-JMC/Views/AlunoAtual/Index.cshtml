@model IEnumerable<SGI_JMC.Models.AlunoAtual>
<partial name="_MensagemPartial" />
@{
    ViewData["Title"] = "Alunos - " + " " + DateTime.Now.Year.ToString() + " - ";
}

<div class="container-fluid">

    <div class="card border-primary mb-3">
        <div class="card-header">
            <h4><b>Alunos Matriculados</b></h4>
            <h6>
                <a href="../AlunoAtual/AdicionarAluno" class="btn btn-default pull-right fa fa-user-plus"> Adicionar</a>
            </h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Nascimento</th>
                            <th>Ano/Série</th>
                            <th>Telefone</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            if (!item.Transferido)
                            {
                                int count = 1;
                                <tr>
                                    <td>@item.Nome</td>
                                    <td>@item.DataNascimento.ToString("dd/MM/yyyy")</td>

                                    @if (@item.CorrecaoDeFluxo.Equals("Sim"))
                                    {
                                        <td>Fase @item.FaseProSic - @item.SerieOrigem º </td>

                                    }
                                    else
                                    {
                                        <td>@item.anoSerie º @item.turma</td>

                                    }


                                    <td>@item.Telefone</td>
                                    <td style="align-content:center">
                                        <a asp-action="VisualizarAluno" asp-route-id=@item.Id>
                                            <i class="btn btn-outline-info btn-sm fa fa-eye"
                                       title="Ver ficha completa"></i>
                                        </a>
                                        @if (User.IsInRole("administrador"))
                                        {
                                            <a asp-action="EditarAluno" asp-route-id=@item.Id>
                                                <i class="btn btn-outline-primary btn-sm fa fa-pencil"
                                       title="Editar"></i>
                                            </a>
                                        }
                                        @if (@item.CorrecaoDeFluxo.Equals("Não"))
                                        {
                                            <a asp-action="PreencherDeclaracao" asp-route-id=@item.Id>
                                                <i class="btn btn-outline-success btn-sm fa fa-file-pdf-o"
                                       title="Declaração de Frequência"></i>
                                            </a>
                                            <a asp-action="DeclaracaoTransferencia" asp-route-id=@item.Id>
                                                <i class="btn btn-outline-warning btn-sm fa fa-exclamation"
                                       title="Declaração de Transferência"></i>
                                            </a>
                                        }
                                        @if (@item.CorrecaoDeFluxo.Equals("Sim"))
                                        {
                                            <a asp-action="PreencherDeclaracaoProSic" asp-route-id=@item.Id>
                                                <i class="btn btn-outline-dark btn-sm fa fa-file-pdf-o"
                                       title="Declaração de Frequência ProSic"></i>
                                            </a>
                                            <a asp-action="DeclaracaoTransferenciaProSic" asp-route-id=@item.Id>
                                                <i class="btn btn-outline-dark btn-sm fa fa-exclamation" title="Declaração de Transferência ProSic"></i>
                                            </a>
                                        }

                                        @if (User.IsInRole("administrador"))
                                        {
                                            <a asp-action="ExcluirAluno" asp-route-id=@item.Id>
                                                <i class="btn btn-outline-danger btn-sm fa fa-trash"
                                       title="ExcluirAluno"></i>
                                            </a>
                                            @*                                        <a asp-action="ReprovarAluno" asp-route-id=@item.Id>
                                <i class="btn btn-outline-danger btn-sm fa fa-user-times"
                                title="ReprovarAluno"></i>
                                </a>*@
                                        }

                                    </td>
                                </tr>
                                count++;

                            }

                        }
                    </tbody>
                </table>
                @section Scripts{
                    <script>
                        $(document).ready(function () {
                            $('#dataTable').DataTable({
                                language: {
                                    url: '//cdn.datatables.net/plug-ins/1.12.1/i18n/pt-BR.json'
                                }
                            });
                        });
                    </script>
                }
                </div>
            </div>
        </div>
    </div>
