@model IEnumerable<SGI_JMC.Models.DeclaracaoDistanciaInteriorizacao>
<partial name="_MensagemPartial" />
@{
    ViewData["Title"] = "Declarações de distância para interiorização - ";
}
<p></p>

<div class="container-fluid">

    <div class="card mb-3">
        <div class="card-header">
            <h4><b>Declarações de distância para interiorização</b></h4>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            int count = 1;
                            <tr>
                                <td>@item.Nome</td>
                                <td style="align-content:center">
                                    <a asp-action="ConferirDadosReimprimirDeclaracao" asp-route-id=@item.Id>
                                        <i class="btn btn-outline-info fa fa-print"
                                       title="Conferir dados e reimprimir"></i>
                                    </a>
                                    <a asp-action="AtualizarDeclaracao" asp-route-id=@item.Id>
                                        <i class="btn btn-outline-primary fa fa-pencil"
                                       title="Editar dados"></i>
                                    </a>
                            </tr>
                            count++;
                        }
                    </tbody>
                </table>
                @section Scripts{
                    <script>
                        $(document).ready(function () {
                            $('#dataTable').DataTable({
                                language: {
                                    url: '//cdn.datatables.net/plug-ins/1.12.1/i18n/pt-BR.json'
                                }
                            });
                        });
                    </script>
                }
                </div>
            </div>
        </div>
    </div>
