@model SGI_JMC.Models.DeclaracaoDistanciaInteriorizacao

@{
    ViewData["Title"] = "Declaração de distância para interiorização - ";
}
<hr />
<div class="container-fluid">
    <div class="card mb-3">
        <div class="card-header">
            <h4><b>Declaração de distância para interiorização</b></h4>
        </div>
        <div class="card-body">
            <form asp-action="gerarDeclaracaoDistanciaInteriorizacao">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Nome" class="control-label"></label>
                            <input asp-for="Nome" class="form-control" />
                            <span asp-validation-for="Nome" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="CPF" class="control-label"></label>
                            <input asp-for="CPF" placeholder="Somente números" maxlength="14" class="form-control" />
                            <span asp-validation-for="CPF" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="RG" class="control-label"></label>
                            <input asp-for="RG" class="form-control" />
                            <span asp-validation-for="RG" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="OrgaoExpedidor" class="control-label"></label>
                            <input asp-for="OrgaoExpedidor" class="form-control" />
                            <span asp-validation-for="OrgaoExpedidor" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="InicioExercicio" class="control-label"></label>
                            <input asp-for="InicioExercicio" class="form-control" />
                            <span asp-validation-for="InicioExercicio" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="EstadoResidencia" class="control-label"></label>
                            <input asp-for="EstadoResidencia" placeholder="preencha somente se o servidor(a) residir em outro estado" class="form-control" />
                            <span asp-validation-for="EstadoResidencia" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="CargaHorariaSemanal" class="control-label"></label>
                            <input asp-for="CargaHorariaSemanal" class="form-control" maxlength="3  " />
                            <span asp-validation-for="CargaHorariaSemanal" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Origem" class="control-label"></label>
                            <input asp-for="Origem" class="form-control" />
                            <span asp-validation-for="Origem" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Destino" class="control-label"></label>
                            <input asp-for="Destino" class="form-control" />
                            <span asp-validation-for="Destino" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Distancia" class="control-label"></label>
                            <input asp-for="Distancia" class="form-control" maxlength="3" />
                            <span asp-validation-for="Distancia" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Turmas" class="control-label"></label>
                            <input asp-for="Turmas" class="form-control" />
                            <span asp-validation-for="Turmas" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="CidadeEntrada" class="control-label"></label>
                            <input asp-for="CidadeEntrada" placeholder="preencha somente se o servidor(a) residir em outro estado" class="form-control" />
                            <span asp-validation-for="CidadeEntrada" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-12" style="text-align:center">
                        <button type="submit" class="btn btn-success"><i class="fa fa-download" aria-hidden="true"></i> Baixar declaração</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {

    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.0/jquery.mask.js"></script>
    <script>
        $(document).ready(function () {
            var $CPF = $("#CPF");
            $CPF.mask('000.000.000-00', { reverse: true });
        });
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }
