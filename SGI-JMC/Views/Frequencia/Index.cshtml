@model SGI_JMC.Models.Frequencia

<div class="text-center">
    <h1 class="display-4">Sistema de Gerenciamento Interno</h1>
    <h4 class="display-6">Escola Estadual João de Mattos Carvalho</h4>
    <p></p>
    <div>
        <a href="../Declaracao/VerificarAutenticidade" class="btn btn-primary">Verificar autenticidade de documento</a>
    </div>
    <p></p>
    <div class="container">
        <img src="~/Imagens/SemTransparencia.png" width="350px" />
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="myModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header" style="background:lightsteelblue">
                <h3>Calculadora de Presença</h3>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <form asp-action="Index">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label asp-for="QuantidadeFaltas" class="control-label"></label>
                                <input asp-for="QuantidadeFaltas" class="form-control" />
                                <span asp-validation-for="QuantidadeFaltas" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <h6>Percentual de Frequência</h6>
                                <h4 style="color: red">
                                    @ViewData["resultado"]%
                                </h4>
                            </div>
                        </div>
                        <p></p>
                        <div class="col-md-12" style="text-align:center">
                            <button type="submit" class="btn btn-success btn-block"><i class="fa fa-calculator" aria-hidden="true"></i> Calcular Frequência</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- jquery -->
<script src="//code.jquery.com/jquery-1.11.0.min.js"></script>
<!-- bootstrap -->
<script type="text/javascript" src="js/bootstrap.js"></script>
<!-- chamada da função -->
<script type="text/javascript">
    $(window).load(function () {
        $('#myModal').modal('show');
    });
</script>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    }