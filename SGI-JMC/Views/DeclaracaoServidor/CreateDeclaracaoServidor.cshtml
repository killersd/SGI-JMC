@model SGI_JMC.Models.DeclaracaoServidor

@{
    ViewData["Title"] = "Declaração servidor ativo - ";
}
<hr />
<div class="container-fluid">
    <div class="card mb-3">
        <div class="card-header">
            <h4><b>Declaração de Servidor (ativo)</b></h4>
        </div>
        <div class="card-body">
            <form asp-action="gerarDeclaracaoServidor">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Nome" class="control-label"></label>
                            <input asp-for="Nome" class="form-control" />
                            <span asp-validation-for="Nome" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="CPF" class="control-label"></label>
                            <input asp-for="CPF" placeholder="Somente números" maxlength="14" class="form-control" />
                            <span asp-validation-for="CPF" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="cargo" class="control-label"></label>
                            <input asp-for="cargo" class="form-control" />
                            <span asp-validation-for="cargo" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="CargaHoraria" class="control-label"></label>
                            <input asp-for="CargaHoraria" class="form-control" />
                            <span asp-validation-for="CargaHoraria" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="vinculo" class="control-label"></label>
                            <input asp-for="vinculo" placeholder="Efetivo ou contratado" class="form-control" />
                            <span asp-validation-for="vinculo" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="DataInicioExercicio" class="control-label"></label>
                            <input asp-for="DataInicioExercicio" class="form-control" />
                            <span asp-validation-for="DataInicioExercicio" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-12" style="text-align:center">
                        <button type="submit" class="btn btn-success"><i class="fa fa-download" aria-hidden="true"></i> Baixar declaração</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.0/jquery.mask.js"></script>
    <script>
        $(document).ready(function () {
            var $CPF = $("#CPF");
            $CPF.mask('000.000.000-00', { reverse: true });
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }
