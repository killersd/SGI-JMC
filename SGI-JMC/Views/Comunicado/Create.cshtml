@model SGI_JMC.Models.Comunicado

@{
    ViewData["Title"] = "Comunicado de comparecimento - ";
}
<hr />
<div class="container-fluid">
    <div class="card mb-3">
        <div class="card-header">
            <h4><b>Comunicado de comparecimento</b></h4>
        </div>
        <div class="card-body">
            <form asp-action="gerarComunicado">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="NomeAluno" class="control-label"></label>
                            <input asp-for="NomeAluno" class="form-control" />
                            <span asp-validation-for="NomeAluno" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Turma" class="control-label"></label>
                            <input asp-for="Turma" class="form-control" placeholder="7º,8º,9º ano, Fase 03, Fase 04..." />
                            <span asp-validation-for="Turma" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Turno" class="control-label"></label>
                            <input asp-for="Turno" class="form-control" />
                            <span asp-validation-for="Turno" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="DataComparecimento" class="control-label"></label>
                            <input asp-for="DataComparecimento" class="form-control" />
                            <span asp-validation-for="DataComparecimento" class="text-danger"></span>
                        </div>

                    </div>
                    <div class="col-md-6">

                        <div class="form-group">
                            <label asp-for="Observacao" class="control-label"></label>
                            <textarea style="resize:none" MaxLength="475" rows="7" cols="10" asp-for="Observacao" class="form-control"></textarea>
                            <span asp-validation-for="Observacao" class="text-danger"></span>
                        </div>
                        <div class="form-group" style="width:504px;height:62px;">
                            <label asp-for="MembroEquipeDiretiva" class="control-label"></label>
                            <fieldset>
                                <div>
                                    <input asp-for="MembroEquipeDiretiva" type="radio" id="" name="MembroEquipeDiretiva" value="Alex">
                                    <label for="Alex">Alex</label>
                                </div>
                                <div>
                                    <input asp-for="MembroEquipeDiretiva" type="radio" id="Vera" name="MembroEquipeDiretiva" value="Vera">
                                    <label for="Vera">Vera</label>
                                </div>
                            </fieldset>
                            <span asp-validation-for="MembroEquipeDiretiva" class="text-danger"></span>
                        </div>
                    </div>
                    @*                    <div class="col-md-12">
                    <label asp-for="Observacao" class="control-label"></label>
                    <textarea asp-for="Observacao" style="resize:none" MaxLength="475" rows="2" cols="10" class="form-control"></textarea>
                    <span asp-validation-for="Observacao" class="text-danger"></span>
                    </div>*@
                    <p></p>
                </div>
                <div class="col-md-12" style="text-align:center">
                    <p></p>
                    <button type="submit" class="btn btn-success"><i class="fa fa-download" aria-hidden="true"></i> Baixar comunicado</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }

