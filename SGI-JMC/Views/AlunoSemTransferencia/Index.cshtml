@model IEnumerable<SGI_JMC.Models.AlunoSemTransferencia>
<partial name="_MensagemPartial" />
@{
    ViewData["Title"] = "Alunos sem transferêcia da escola anterior- ";
}
<p></p>

<div class="container-fluid">

    <div class="card mb-3">
        <div class="card-header">
            <h4><b>Alunos sem transferência da escola anterior</b></h4>
            <h6>
                <a href="../AlunoSemTransferencia/Create" class="btn btn-primary pull-right fa fa-user-plus"> Adicionar</a>
            </h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Pai</th>
                            <th>Mãe</th>
                            <th>Data de nascimento</th>
                            <th>Escola anterior</th>
                            @if (Context.User.IsInRole("administrador"))
                            {
                                <th>Operações disponíveis</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Nome</td>
                                <td>@item.NomePai</td>
                                <td>@item.NomeMae</td>
                                <td>@item.DataNasciimento.ToString("dd/MM/yyyy")</td>
                                <td>@item.EscolaAnterior</td>

                                @if (Context.User.IsInRole("administrador"))
                                {
                                    <td>
                                        @if (@item.TemPendencia == 0)
                                        {
                                            <a asp-action="AdicionarPendencia" asp-route-id=@item.Id>
                                                <i class="btn btn-sm btn-outline-success fa fa-plus"
                                       title="Adicionar Pendência"></i>
                                            </a>
                                            <a asp-action="Update" asp-route-id=@item.Id>
                                                <i class="btn btn-sm btn-outline-primary fa fa-pencil"
                                       title="Editar pendência"></i>
                                            </a>
                                            <a asp-action="DeletarPendencia" asp-route-id=@item.Id>
                                                <i class="btn btn-sm btn-outline-danger fa fa-trash"
                                       title="Excluir registro"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-action="RemoverPendencia" asp-route-id=@item.Id>
                                                <i class="btn btn-sm btn-outline-danger fa fa-minus"
                                       title="Remover pendência"></i>
                                            </a>
                                        }
                                    </td>

                                }
                            </tr>
                        }
                    </tbody>
                </table>
                @section Scripts{
                    <script>
                        $(document).ready(function () {
                            $('#dataTable').DataTable({
                                language: {
                                    url: '//cdn.datatables.net/plug-ins/1.12.1/i18n/pt-BR.json'
                                }
                            });
                        });
                    </script>
                }
                </div>
            </div>
        </div>
    </div>
