@model IEnumerable<SGI_JMC.Models.AlunoSemTransferencia>
<partial name="_MensagemPartial" />
@{
    ViewData["Title"] = "Alunos sem transferêcia da escola anterior- ";
}
<p></p>

<div class="container-fluid">

    <div class="card mb-3">
        <div class="card-header">
            <h4><b>Alunos sem transferência da escola anterior</b></h4>
            <h6>
                <a href="../AlunoSemTransferencia/Create" class="btn btn-primary pull-right fa fa-user-plus"> Adicionar</a>
            </h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Pai</th>
                            <th>Mãe</th>
                            <th>Data de nascimento</th>
                            <th>Escola anterior</th>
                            @*<th>Ação</th>*@
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Nome</td>
                                <td>@item.NomePai</td>
                                <td>@item.NomeMae</td>
                                <td>@item.DataNasciimento</td>
                                <td>@item.EscolaAnterior</td>
                                @*<td>
                                    <a asp-action="AdicionarPendencia" asp-route-id=@item.Id>
                                        <i class="fa fa-plus"
                                       title="Adicionar Pendência"></i>
                                    </a>
                                    <a asp-action="RemoverPendencia" asp-route-id=@item.Id>
                                        <i class="fa fa-minus"
                                       title="Remover pendência"></i>
                                    </a>
                                </td>*@
                            </tr>
                        }
                    </tbody>
                </table>
                @section Scripts{
                    <script>
                        $(document).ready(function() {
                            $('#dataTable').DataTable({
                                language: {
                                    url: '//cdn.datatables.net/plug-ins/1.12.1/i18n/pt-BR.json'
                                }
                            });
                        });
                    </script>
                }
                </div>
            </div>
        </div>
    </div>
