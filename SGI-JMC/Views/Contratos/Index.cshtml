@model IEnumerable<SGI_JMC.Models.Contratos>
<partial name="_MensagemPartial" />
@{
    ViewData["Title"] = "Servidores contratados - ";
}
<p></p>
<div class="container-fluid">

    <div class="card border-primary mb-3">
        <div class="card-header">
            <h4><b>Servidores contratados</b></h4>
            <h6>
                <a href="../Contratos/AdicionarGet" class="btn btn-default pull-right fa fa-user-plus" style="color:#fbc45f"> Adicionar</a>
            </h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Cargo</th>
                            <th>Início do contrato</th>
                            <th>Final do contrato</th>
                            <th>Situação</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            int count = 1;
                            <tr>
                                <td>@item.Nome</td>
                                <td>@item.Cargo</td>
                                <td>@item.InicioContrato.ToString("dd/MM/yyyy")</td>
                                <td>@item.FimContrato.ToString("dd/MM/yyyy")</td>
                                @if (item.renovado)
                                {
                                    <td>Renovado</td>
                                }
                                else
                                {
                                    <td>Não renovado</td>
                                }
                                <td style="align-content:center">
                                    <a asp-action="EditarContratado" asp-route-id=@item.Id>
                                        <i class="btn btn-outline-primary fa fa-pencil"
                                       title="Editar"></i>
                                    </a>
                                    @if (item.renovado)
                                    {
                                        <a asp-action="DesfazerRenovacao" asp-route-id=@item.Id>
                                            <i class="btn btn-outline-warning fa fa-undo"
                                       title="desfazer renovação contrato"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="RenovarContrato" asp-route-id=@item.Id>
                                            <i class="btn btn-outline-success fa fa-check"
                                       title="indicar renovação contrato"></i>
                                        </a>
                                    }
                                    <a asp-action="ExcluirServidorContratado" asp-route-id=@item.Id>
                                        <i class="btn btn-outline-danger fa fa-trash"
                                       title="Excluir"></i>
                                    </a>
                                </td>
                            </tr>
                            count++;
                        }
                    </tbody>
                </table>
                @section Scripts{
                    <script>
                        $(document).ready(function () {
                            $('#dataTable').DataTable({
                                language: {
                                    url: '//cdn.datatables.net/plug-ins/1.12.1/i18n/pt-BR.json'
                                }
                            });
                        });
                    </script>
                }
                </div>
            </div>
        </div>
    </div>
