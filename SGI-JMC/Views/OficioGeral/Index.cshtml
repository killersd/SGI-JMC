@model IEnumerable<SGI_JMC.Models.OficioGeral>
@{
    ViewData["Title"] = "Ofícios gerais expedidos - ";
}

<div class="container-fluid">
    <div class="card mb-3">
        <div class="card-header">
            <h4><b>Ofícios Gerais Expedidos</b></h4>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Número</th>
                            <th>Assunto</th>
                            <th>Destinatário</th>
                            <th>Data de Emissão</th>
                            <th>Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            int count = 1;
                            <tr>
                                <td>@item.NumeroOficio</td>
                                <td>@item.Assunto</td>
                                <td>@item.destinatario</td>
                                <td>@item.DataEmissao</td>
                                <td>
                                    <a asp-action="Details" asp-route-id=@item.Id>
                                        <i class="btn btn-outline-info fa fa-eye"
                                       title="Ver"></i>
                                    </a>
                                </td>
                            </tr>
                            count++;
                        }
                    </tbody>
                </table>
                @section Scripts{
                    <script>
                        $(document).ready(function() {
                            $('#dataTable').DataTable({
                                language: {
                                    url: '//cdn.datatables.net/plug-ins/1.12.1/i18n/pt-BR.json'
                                }
                            });
                        });
                    </script>
                }
                </div>
            </div>
        </div>
    </div>
