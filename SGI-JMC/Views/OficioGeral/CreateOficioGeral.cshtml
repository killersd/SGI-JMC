@model SGI_JMC.Models.OficioGeral

@{
    ViewData["Title"] = "Ofício geral - ";
}
<hr />
<div class="container-fluid">
    <div class="card border-primary mb-3">
        <div class="card-header">
            <h4><b>Ofício Padrão</b></h4>
            <h6>Modelo de ofício padrão</h6>
        </div>
        <div class="card-body">
            <form asp-action="gerarOficio">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="NumeroOficio" class="control-label"></label>
                            <input asp-for="NumeroOficio" class="form-control" />
                            <span asp-validation-for="NumeroOficio" class="text-danger"></span>
                        </div>
                        <div class="form-group" style="width:504px;height:62px;">
                            <label asp-for="Remetente" class="control-label"></label>
                            @* <input asp-for="Remetente" class="form-control" placeholder="Alex ou Vera" />*@
                            <fieldset>
                                <div>
                                    <input asp-for="Remetente" type="radio" id="" name="Remetente" value="Alex">
                                    <label for="Alex">Alex</label>
                                </div>
                                <div>
                                    <input asp-for="Remetente" type="radio" id="Vera" name="Remetente" value="Vera">
                                    <label for="Vera">Vera</label>
                                </div>
                            </fieldset>
                            <span asp-validation-for="Remetente" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="CargoDoDestinatario" class="control-label"></label>
                            <input asp-for="CargoDoDestinatario" class="form-control" />
                            <span asp-validation-for="CargoDoDestinatario" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Assunto" class="control-label"></label>
                            <input asp-for="Assunto" class="form-control" />
                            <span asp-validation-for="Assunto" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="destinatario" class="control-label"></label>
                            <input asp-for="destinatario" placeholder="Para quem é o ofício?" class="form-control" />
                            <span asp-validation-for="destinatario" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Cidade" class="control-label"></label>
                            <input asp-for="Cidade" placeholder="Ex. Lagarto-Se, Aracaju-Se, Paripiranga-Ba" class="form-control" />
                            <span asp-validation-for="Cidade" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <label asp-for="CorpoDoOficio" class="control-label"></label>
                        <textarea style="resize:none" placeholder="digite aqui o conteúdo do ofício..." MaxLength="1750" rows="7" cols="10" asp-for="CorpoDoOficio" class="form-control"></textarea>
                        <span asp-validation-for="CorpoDoOficio" class="text-danger"></span>
                    </div>
                    <p></p>
                </div>
                <p></p>
                <div class="col-md-12" style="text-align:center">
                    <button type="submit" class="btn btn-success"><i class="fa fa-download" aria-hidden="true"></i> Baixar ofício</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }
