@model IEnumerable<SGI_JMC.Models.aluno>
<partial name="_MensagemPartial" />
@{
    ViewData["Title"] = "Arquivo morto - ";
}
<p></p>
@*<h3>Alunos Cadastrados</h3>*@

<div class="container-fluid">

    <div class="card border-primary mb-3">
        <div class="card-header">
            <h4><b>Arquivo Morto</b></h4>
            <h6>
                <a href="../Aluno/CreateStudent" class="btn btn-primary pull-right fa fa-user-plus"> Adicionar</a>
            </h6>
            @*<h4><b>Arquivo Morto</b></h4>*@
            @*<a href="../aluno/CreateStudent" class="btn btn-info pull-right fa fa-plus"> Adicionar aluno</a>*@
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Pai</th>
                            <th>Mãe</th>
                            <th>Data de nascimento</th>
                            <th>Ano da pasta</th>
                            <th>Ações (Editar/Excluir)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            int count = 1;
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.Father_name</td>
                                <td>@item.Mother_name</td>
                                <td>@item.Birth_date.ToString("dd/MM/yyyy")</td>
                                <td>@item.Year_folder</td>
                                <td style="align-content:center">
                                    <a asp-action="Details" asp-route-id=@item.Id>
                                        <i class="btn btn-outline-info fa fa-eye"
                                       title="Ver"></i>
                                    </a>
                                    <a asp-action="UpdateStudent" asp-route-id=@item.Id>
                                        <i class="btn btn-outline-primary fa fa-pencil"
                                       title="Editar"></i>
                                    </a>
                                    <a asp-action="DeleteStudent" asp-route-id=@item.Id>
                                        <i class="btn btn-outline-danger fa fa-trash"
                                       title="Excluir"></i>
                                    </a>
                                </td>
                            </tr>
                            count++;
                        }
                    </tbody>
                </table>
                @section Scripts{
                    <script>
                        $(document).ready(function() {
                            $('#dataTable').DataTable({
                                language: {
                                    url: '//cdn.datatables.net/plug-ins/1.12.1/i18n/pt-BR.json'
                                }
                            });
                        });
                    </script>
                }
                </div>
            </div>
        </div>
    </div>
