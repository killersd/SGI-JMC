@model SGI_JMC.Models.NotificacaoPendenciaDiario

@{
    ViewData["Title"] = "Notificação - ";
}

<partial name="_MensagemPartial" />

@*<div asp-validation-summary="ModelOnly" class="val-summary text-danger my-3"></div>*@
<hr />
<div class="container-fluid">
    <div class="card mb-6">
        <div class="card-header">
            <h4><b>Notificação</b></h4>
            <h6>Pendências no diário eletrônico</h6>
        </div>
        <div class="card-body">
            <form asp-action="gerarNotificacao">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label asp-for="Name" class="control-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="qtdAulas" class="control-label"></label>
                            <input asp-for="qtdAulas" class="form-control" />
                            <span asp-validation-for="qtdAulas" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="dataLimite" class="control-label"></label>
                            <input asp-for="dataLimite" class="form-control" />
                            <span asp-validation-for="dataLimite" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-12" style="text-align:center">
                        @*<input type="submit" value="Baixar declaração" class="btn btn-default" />*@
                        <button type="submit" class="btn btn-default" style="color:#fbc45f"><i class="fa fa-download" aria-hidden="true"></i> Baixar notificação</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }