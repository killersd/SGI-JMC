@model SGI_JMC.Models.DeclaracaoResidencia

@{
    ViewData["Title"] = "Declaração de residência para interiorização - ";
}
<hr />
<div class="container-fluid">
    <div class="card mb-3">
        <div class="card-header">
            <h4><b>Declaração de residência para interiorização</b></h4>
        </div>
        <div class="card-body">
            <form asp-action="gerarDeclaracaoResidencia">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Nome" class="control-label"></label>
                            <input asp-for="Nome" class="form-control" />
                            <span asp-validation-for="Nome" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="CPF" class="control-label"></label>
                            <input asp-for="CPF" placeholder="Somente números" maxlength="11" class="form-control" />
                            <span asp-validation-for="CPF" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-12" style="text-align:center">
                        <button type="submit" class="btn btn-success"><i class="fa fa-download" aria-hidden="true"></i> Baixar declaração</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }
