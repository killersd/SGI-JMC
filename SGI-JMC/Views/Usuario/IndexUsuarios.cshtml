@model IEnumerable<IdentityUser>
<partial name="_MensagemPartial" />
@{
    ViewData["Title"] = "Usuários cadastrados - ";
    var administradores = ViewBag.Administradores as IEnumerable<string>;
    var usuarios = ViewBag.Usuarios as IEnumerable<string>;
}

<p></p>
@*<h3>Alunos Cadastrados</h3>*@


<div class="card border-primary mb-3">
    <div class="card-header">
        <h4><b>Usuários cadastrados no sistema</b></h4>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>Nome de Usuário</th>
                        <th>E-mail</th>
                        <th>Telefone</th>
                        <th>Usuário</th>
                        <th>Administrador</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var usuario in Model)
                    {
                        <tr>
                            <td>@usuario.UserName</td>
                            <td>@usuario.Email</td>
                            <td>@usuario.PhoneNumber</td>
                            <td>@(usuarios.Contains(usuario.UserName) ? "Sim" : "Não")</td>
                            <td>@(administradores.Contains(usuario.UserName) ? "Sim" : "Não")</td>
                            <td>
                                <a asp-action="Cadastrar" asp-route-id="@usuario.Id" class="btn btn-sm btn-primary">
                                    <i class="fa fa-pencil" title="Alterar"></i>
                                </a>
                                @if (administradores.Contains(usuario.UserName))
                                {
                                    <a asp-action="RemAdministrador" asp-route-id="@usuario.Id" class="btn btn-sm btn-danger">
                                        <i class="fa fa-user-times" aria-hidden="true" title="Remover perfil administrador"></i>
                                    </a>
                                }
                                else
                                {
                                    <a asp-action="AddAdministrador" asp-route-id="@usuario.Id" class="btn btn-sm btn-success">
                                        <i class="fa fa-user-plus" title="Adicionar perfil administrador"></i>
                                    </a>
                                }
                                @if (usuarios.Contains(usuario.UserName))
                                {
                                    <a asp-action="RemPerfilUsuario" asp-route-id="@usuario.Id" class="btn btn-sm btn-danger">
                                        <i class="fa fa-user-times" aria-hidden="true" title="Remover perfil usuário"></i>
                                    </a>
                                }
                                else
                                {
                                    <a asp-action="AddPerfilUsuario" asp-route-id="@usuario.Id" class="btn btn-sm btn-primary">
                                        <i class="fa fa-user-plus" title="Adicionar perfil usuário"></i>
                                    </a>
                                }

                                <a asp-action="Excluir" asp-route-id="@usuario.Id" class="btn btn-sm btn-danger">
                                    <i class="fa fa-trash"
                                   title="Excluir"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @section Scripts{
                <script>
                    $(document).ready(function() {
                        $('#dataTable').DataTable({
                            language: {
                                url: '//cdn.datatables.net/plug-ins/1.12.1/i18n/pt-BR.json'
                            }
                        });
                    });
                </script>
            }
            </div>
        </div>
    </div>
            </div>

