@using SGI_JMC;
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@if (Context.User.Identity.IsAuthenticated)
{


    @*<span class="nav-link text-info">Bem vindo(a), <b>@Context.User.Identity.Name</b>!</span>
    <a class="nav-link pe-0" asp-controller="Usuario" asp-action="Logout">Sair</a>
    <a class="nav-link pe-0" asp-controller="Usuario" asp-action="AlterarSenha">Alterar senha</a>*@



    <li class="nav-link dropdown">
        <a class="nav-link dropdown-toggle text-info" href="#" role="button" data-toggle="dropdown">
            Olá, <b>@Context.User.Identity.Name</b>!
        </a>
        <ul class="dropdown-menu dropdown-menu-end">
            <li>
                <a class="dropdown-item" asp-controller="Usuario" asp-action="AlterarSenha" classes-if-active="disabled">
                    Alterar Senha
                </a>
            </li>
            <li>
                <hr class="dropdown-divider">
            </li>
            <li>
                <a class="dropdown-item" asp-controller="Usuario" asp-action="Logout">Sair</a>
            </li>
        </ul>
    </li>


    <a class="nav-link" asp-controller="Declaracao" asp-action="Create">Emitir declaração</a>

    @if (Context.User.IsInRole("administrador"))
    {
        <a class="nav-link" asp-controller="Usuario" asp-action="IndexUsuarios">Usuários</a>
        <a class="nav-link" asp-controller="Usuario" asp-action="Cadastrar">Novo usuário</a>
    }
    <a class="nav-link" asp-controller="Aluno" asp-action="Index">Arquivo Morto</a>

}
else
{
    <a class="nav-link pe-0" asp-controller="Usuario" asp-action="Login">Entrar</a>
}