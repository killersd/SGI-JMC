@using SGI_JMC;
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@if (Context.User.Identity.IsAuthenticated)
{
    <li class="nav-link dropdown">
        <a class="nav-link dropdown-toggle text-info" href="#" role="button" data-toggle="dropdown">
            Olá, <b>@Context.User.Identity.Name</b>!
        </a>
        <ul class="dropdown-menu dropdown-menu-end">
            <li>
                <a class="dropdown-item" asp-controller="Usuario" asp-action="AlterarSenha" classes-if-active="disabled">
                    Alterar Senha
                </a>
            </li>
            <li>
                <hr class="dropdown-divider">
            </li>
            <li>
                <a class="dropdown-item" asp-controller="Usuario" asp-action="Logout">Sair</a>
            </li>
        </ul>
    </li>

    @if (Context.User.IsInRole("administrador"))
    {
        <li class="nav-link dropdown">
            <a class="nav-link dropdown-toggle text-info" href="#" role="button" data-toggle="dropdown">
                Usuários
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <a class="dropdown-item" asp-controller="Usuario" asp-action="IndexUsuarios" classes-if-active="disabled">
                        Todos
                    </a>
                </li>
                <li>
                    <hr class="dropdown-divider">
                </li>
                <li>
                    <a class="dropdown-item" asp-controller="Usuario" asp-action="Cadastrar">Novo</a>
                </li>
            </ul>
        </li>
    }

    <li class="nav-link dropdown">
        <a class="nav-link dropdown-toggle text-info" href="#" role="button" data-toggle="dropdown">
            Declarações
        </a>
        <ul class="dropdown-menu dropdown-menu-end">
            <li>
                <a class="dropdown-item" asp-controller="Declaracao" asp-action="Create" classes-if-active="disabled">
                    Frequência (Regular)
                </a>
            </li>
            <li>
                <hr class="dropdown-divider">
            </li>
            <li>
                <a class="dropdown-item" asp-controller="Declaracao" asp-action="CreateProSic">Frequência (ProSic)</a>
            </li>
            <li>
                <hr class="dropdown-divider">
            </li>
            <li>
                <a class="dropdown-item" asp-controller="Declaracao" asp-action="CreateTransferenciaRegular">Transferência (Regular)</a>
            </li>
            <li>
                <hr class="dropdown-divider">
            </li>
            <li>
                <a class="dropdown-item" asp-controller="Declaracao" asp-action="CreateTransferenciaProSic">Transferência (ProSic)</a>
            </li>
        </ul>
    </li>

    <li class="nav-link dropdown">
        <a class="nav-link dropdown-toggle text-info" href="#" role="button" data-toggle="dropdown">
            Arquivo Morto
        </a>
        <ul class="dropdown-menu dropdown-menu-end">
            <li>
                <a class="dropdown-item" asp-controller="Aluno" asp-action="Index" classes-if-active="disabled">
                    Consultar
                </a>
            </li>
            <li>
                <hr class="dropdown-divider">
            </li>
            <li>
                <a class="dropdown-item" asp-controller="Aluno" asp-action="CreateStudent">Cadastrar</a>
            </li>
        </ul>
    </li>
    <li class="nav-link dropdown">
        <a class="nav-link dropdown-toggle text-info" href="#" role="button" data-toggle="dropdown">
            Advertência
        </a>
        <ul class="dropdown-menu dropdown-menu-end">
            <li>
                <a class="dropdown-item" asp-controller="Advertencia" asp-action="GerarAdvertencia" classes-if-active="disabled">
                    Nova
                </a>
            </li>
            <li>
                <hr class="dropdown-divider">
            </li>            
        </ul>
    </li>
    @*<a class="nav-link pe-0" asp-controller="Advertencia" asp-action="GerarAdvertencia">Advertência</a>*@
}
else
{
    <a class="nav-link pe-0" asp-controller="Usuario" asp-action="Login">Entrar</a>
}