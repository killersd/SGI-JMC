<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]SGI-EEJMC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @*<link rel="stylesheet" href="~/css/site.css" />*@
    <link rel="stylesheet" href="~/css/MyStyle.css" />
    <link rel="stylesheet" href="/lib/limonte-sweetalert2/sweetalert2.min.css" />
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/v/dt/dt-1.12.1/datatables.min.css" />
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
</head>
<body style="min-width:372px;">
    @*    <header>
    <nav class="navbar navbar-expand-lg navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3" style="background-color:#E0FFFF	">
    <div class="container">
    <div class="logo">
    <h1><a href="/Home/Index">SGI <span> - EEJMC</span></a> </h1>
    Sistema de Gerenciamento Interno
    </div>
    <div class="navbar-collapse collapse d-sm-inline-flex flex-sm-row-reverse">
    <partial name="_LoginPartial" />
    </div>
    </div>
    </nav>
    </header>*@
    <nav class="navbar navbar-expand-lg border-bottom shadow-sm mb-3 navbar-light" @*style="background-color: #e3f2fd;*@">
        <div class="container">
            <div class="logo">
                <h1><a href="/Home/Index">SGI <span> - EEJMC</span></a> </h1>
                Sistema de Gerenciamento Interno
            </div>
            <button class="navbar-toggler alert-primary" type="button" data-toggle="collapse"
                    data-target=".navbar-collapse">
                <span class="navbar-toggler-icon"></span>
            </button>
        </div>
        <div class="navbar-collapse collapse">

            @*            @if (!Context.User.Identity.IsAuthenticated)
            {
            <ul class="navbar-nav flex-sm-row-reverse flex-grow-1 text-primary">
            <a class="nav-link pe-0 text-primary" asp-controller="Usuario" asp-action="Cadastrar">Cadastre-se</a>
            </ul>
            }*@

            <ul class="navbar-nav flex-sm-row-reverse flex-grow-1 text-primary">
                @if (Context.User.Identity.IsAuthenticated)
                {
                    <li class="nav-link dropdown">
                        <a class="nav-link dropdown-toggle text-primary" href="#" role="button" data-toggle="dropdown">
                            Olá, <b>@Context.User.Identity.Name</b>!
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item" asp-controller="Usuario" asp-action="AlterarSenha" classes-if-active="disabled">
                                    Alterar Senha
                                </a>
                            </li>
                            <li>
                                <hr class="dropdown-divider">
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Usuario" asp-action="Logout">Sair <i class="fa fa-sign-out" aria-hidden="true"></i></a>
                            </li>
                        </ul>
                    </li>

                    @if (!Context.User.IsInRole("administrador") && !Context.User.IsInRole("usuario"))
                    {
                        //Não mostrar nenhum menu
                    }
                    else
                    {
                        @if (Context.User.IsInRole("administrador"))
                        {
                            <li class="nav-link dropdown">
                                <a class="nav-link dropdown-toggle text-primary" href="#" role="button" data-toggle="dropdown">
                                    <i class="fa fa-users" aria-hidden="true"></i> Usuários
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Usuario" asp-action="IndexUsuarios" classes-if-active="disabled">
                                            Todos
                                        </a>
                                    </li>
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Usuario" asp-action="Cadastrar">Novo</a>
                                    </li>
                                </ul>
                            </li>
                            <li class="nav-link dropdown">
                                <a class="nav-link dropdown-toggle text-primary" href="#" role="button" data-toggle="dropdown">
                                    <i class="fa fa-sort" aria-hidden="true"></i> Outros
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Advertencia" asp-action="Create" classes-if-active="disabled">
                                            Advertência
                                        </a>
                                    </li>
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Notificacao" asp-action="Create" classes-if-active="disabled">
                                            Notificação Diário
                                        </a>
                                    </li>
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="oficiogeral" asp-action="createoficiogeral" classes-if-active="disabled">
                                            Ofício (geral)
                                        </a>
                                    </li>
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="AlunoSemTransferencia" asp-action="Create" classes-if-active="disabled">
                                            Alunos sem transferência
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }

                        <li class="nav-link dropdown">
                            <a class="nav-link dropdown-toggle text-primary" href="#" role="button" data-toggle="dropdown">
                                <i class="fa fa-file-text" aria-hidden="true"></i> Declarações
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" asp-controller="Declaracao" asp-action="Create" classes-if-active="disabled">
                                        Frequência (Regular)
                                    </a>
                                </li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Declaracao" asp-action="CreateProSic" classes-if-active="disabled">Frequência (ProSic)</a>
                                </li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Declaracao" asp-action="CreateDeclaracaoTransferenciaRegular">Transferência (Regular)</a>
                                </li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Declaracao" asp-action="CreateDeclaracaoTransferenciaProSic">Transferência (ProSic)</a>
                                </li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="DeclaracaoSabadoLetivo" asp-action="Create">Sábado letivo (Professor)</a>
                                </li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="DeclaracaoExServidor" asp-action="CreateDeclaracaoExServidor">Ex-Servidor</a>
                                </li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="DeclaracaoServidor" asp-action="CreateDeclaracaoServidor">Servidor (Ativo)</a>
                                </li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Declaracao" asp-action="CreateDeclaracaoConcludentesRegular">Concludente (Regular)</a>
                                </li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Declaracao" asp-action="CreateDeclaracaoConcludentesProSic">Concludente (ProSic)</a>
                                </li>
                            </ul>
                        </li>
                        @if (!Context.User.IsInRole("administrador"))
                        {
                            <li class="nav-link dropdown">
                                <a class="nav-link dropdown-toggle text-primary" href="#" role="button" data-toggle="dropdown">
                                    <i class="fa fa-sort" aria-hidden="true"></i>  Outros
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Advertencia" asp-action="Create" classes-if-active="disabled">
                                            Advertência
                                        </a>
                                    </li>
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="AlunoSemTransferencia" asp-action="Create" classes-if-active="disabled">
                                            Alunos sem transferência
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        <li class="nav-link dropdown">
                            <a class="nav-link dropdown-toggle text-primary" href="#" role="button" data-toggle="dropdown">
                                <i class="fa fa-archive" aria-hidden="true"></i> Arquivo Morto
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" asp-controller="Aluno" asp-action="Index" classes-if-active="disabled">
                                        Consultar
                                    </a>
                                </li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Aluno" asp-action="CreateStudent">Cadastrar</a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-link dropdown">
                            <a class="nav-link dropdown-toggle text-primary" href="#" role="button" data-toggle="dropdown">
                                <i class="fa fa-check" aria-hidden="true"></i> Assumiu função
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" asp-controller="OficioAssumiuFuncao" asp-action="CreateOficio" classes-if-active="disabled">
                                        Ofício (Professor)
                                    </a>
                                </li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="HorarioProfessor" asp-action="CreateHorarioProfessor">Horário (Professor)</a>
                                </li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="OficioAssumiuFuncaoServidor" asp-action="CreateOficioServidor">Ofício (Servidor)</a>
                                </li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="HorarioServidor" asp-action="CreateHorarioServidor">Horário (Servidor)</a>
                                </li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="OficioAssumiuFuncaoApoioEscolar2" asp-action="CreateOficioAssumiuFuncaoApoioEscolar2">Ofício (Apoio II)</a>
                                </li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="HorarioApoioEscolar2" asp-action="CreateHorarioApoio2">Horário (Apoio II)</a>
                                </li>
                            </ul>
                        </li>
                        if (Context.User.IsInRole("administrador"))
                        {
                            <li class="nav-link dropdown">
                                <a class="nav-link dropdown-toggle text-primary" href="#" role="button" data-toggle="dropdown">
                                    <i class="fa fa-eye" aria-hidden="true"></i> Documentos Expedidos
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" asp-controller="advertencia" asp-action="index" classes-if-active="disabled">
                                            Advertências
                                        </a>
                                    </li>
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="OficioGeral" asp-action="index" classes-if-active="disabled">
                                            Ofícios (Gerais)
                                        </a>
                                    </li>
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Declaracao" asp-action="IndexTransferenciaRegular" classes-if-active="disabled">
                                            Declarações Transferências (Regular)
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    }
                }
                else
                {
                    <a class="nav-link pe-0 text-primary" asp-controller="Usuario" asp-action="Login"><i class="fa fa-sign-in" aria-hidden="true"></i> Entrar</a>
                }


            </ul>
        </div>
    </nav>
    <div class="container">
        <script src="~/lib/limonte-sweetalert2/sweetalert2.min.js" asp-append-version="true"></script>
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="text-dark bg-light p-1 fixed-bottom text-center">
            SGI-JMC - @DateTime.Now.Year.ToString() -
            &copy;Todos os direitos reservados
        </div>
    </footer>
    <script src="~/lib/CustomJS.js"></script>
    <script src="~/lib/bootstrap5/dist/js/bootstrap.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script type="text/javascript" src="https://cdn.datatables.net/v/dt/dt-1.12.1/datatables.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
